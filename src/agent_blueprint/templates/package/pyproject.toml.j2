[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ dist_name }}"
version = "{{ ir.version }}"
description = "{{ ir.description or ir.name ~ ' — generated by agent-blueprint' }}"
requires-python = ">=3.11"
dependencies = [
{% for dep in dependencies %}
    "{{ dep }}",
{% endfor %}
]

[project.scripts]
{{ dist_name }} = "{{ pkg_name }}.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ pkg_name }}"]
