@app.post("/invoke")
async def invoke(request: Request):
    """Run the agent with a user message.

    Headers:      Authorization: Bearer <JWT>      (deploy.auth.mode: jwt)
    Request body: {"input": ..., "conversation_id": "<uuid>"}   (omit the id to start a new one)
    Response:     {"response": ..., "conversation_id": "<uuid>"}
    """
{% if auth.mode == "jwt" %}
    try:
        user = _verifier.user_id(request.headers.get("authorization"))
    except AuthError as exc:
        headers = {"WWW-Authenticate": "Bearer"} if exc.status == 401 else None
        return _error(exc.status, str(exc), headers)
    rate_key = user
{% else %}
    user = "anonymous"
    rate_key = request.client.host if request.client else "unknown"
{% endif %}

    wait = _rate_limiter.retry_after(rate_key)
    if wait is not None:
        return _error(429, "rate limit exceeded", {"Retry-After": str(wait)})

    try:
        body = await request.json()
    except ValueError:
        return _error(400, "request body must be a JSON object")
    if not isinstance(body, dict):
        return _error(400, "request body must be a JSON object")
    try:
        conversation = conversation_id(body)
    except RequestError as exc:
        return _error(400, str(exc))

    try:
        response = run(body.get("input", ""), thread_id=thread_id(user, conversation))
    except Exception as e:
        return _error(500, str(e))
    return JSONResponse({"response": response, "conversation_id": conversation})


