def conversation_id(body: dict[str, Any]) -> str:
    """Return the request's conversation id, or a new one for a new conversation.

    Ids are random UUIDs so they cannot be guessed; a client continues a
    conversation by sending back the id the previous response returned.
    """
    if "thread_id" in body:
        raise RequestError(
            "'thread_id' is no longer accepted: the server derives the thread from the "
            "authenticated user. Send 'conversation_id' (returned by the first response) "
            "to continue a conversation."
        )
    raw = body.get("conversation_id")
    if raw is None:
        return str(uuid.uuid4())
    if not isinstance(raw, str):
        raise RequestError("'conversation_id' must be a string")
    try:
        parsed = uuid.UUID(raw)
    except ValueError as exc:
        raise RequestError("'conversation_id' must be a UUID returned by this server") from exc
    if parsed.version != 4:
        raise RequestError("'conversation_id' must be a UUID returned by this server")
    return str(parsed)


def thread_id(user: str, conversation: str) -> str:
    """Checkpointer key: the owner is part of the key, so ids never cross users."""
    return f"{user}:{conversation}"


class RateLimiter:
    """Sliding one-minute window per key. State lives in this process only."""

    def __init__(self, per_minute: int, clock: Any = time.monotonic) -> None:
        self._per_minute = per_minute
        self._clock = clock
        self._hits: dict[str, deque[float]] = {}
        self._lock = threading.Lock()

    def retry_after(self, key: str) -> int | None:
        """Record a request; return seconds to wait if it is over the limit, else None."""
        if self._per_minute <= 0:
            return None
        now = self._clock()
        with self._lock:
            hits = self._hits.setdefault(key, deque())
            while hits and now - hits[0] >= 60.0:
                hits.popleft()
            if len(hits) >= self._per_minute:
                return max(1, int(60.0 - (now - hits[0])) + 1)
            hits.append(now)
            # Drop idle keys so the table does not grow with every user ever seen.
            if len(self._hits) > 10_000:
                for stale in [k for k, v in self._hits.items() if not v or now - v[-1] >= 60.0]:
                    del self._hits[stale]
            return None
