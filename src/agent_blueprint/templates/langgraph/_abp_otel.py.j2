"""ABP OpenTelemetry bridge for: {{ ir.name }}"""
# Generated by agent-blueprint {{ ir.version }}
#
# Maps ABP trace events to OpenTelemetry spans:
#   run            -> root span "abp.run"
#   node           -> child span "abp.node <id>" (gen_ai.* attributes)
#   other events   -> span events on the active span
#
# Privacy: only event names, ids, routes, and state HASHES are exported —
# never prompt or completion contents.
#
# Precedence: standard OTEL_* env vars win over blueprint values.
# Kill switch: ABP_OTEL=off disables export entirely.

from __future__ import annotations

import os
import sys
from typing import Any

from _abp_trace import register_trace_observer

TRACING_CONFIG = {
    "exporter": "{{ tracing.exporter.value }}",
    "endpoint": {{ tracing.endpoint | to_python }},
    "protocol": "{{ tracing.protocol.value }}",
    "service_name": {{ (tracing.service_name or ir.name) | to_python }},
    "sample_ratio": {{ tracing.sample_ratio | to_python }},
}

#: Per-node model info for gen_ai.* span attributes (agent nodes only)
NODE_MODELS = {
{% for node in ir.nodes if node.agent %}
    "{{ node.id }}": {"system": "{{ node.resolved_provider }}", "model": "{{ node.resolved_model }}"},
{% endfor %}
}

#: Events that mark the active span as errored
_ERROR_EVENTS = {"tool_failed", "policy_violation", "contract_failed", "retry_exhausted"}

_INITIALIZED = False


class OTelTraceObserver:
    """Bridges ABP trace notifications to OpenTelemetry spans."""

    def __init__(self, tracer: Any, provider: Any) -> None:
        self._tracer = tracer
        self._provider = provider
        self._run_span: Any = None
        self._node_spans: list[tuple[str, Any]] = []  # stack: (node_id, span)

    # -- helpers -------------------------------------------------------

    def _active_span(self) -> Any:
        if self._node_spans:
            return self._node_spans[-1][1]
        return self._run_span

    def _child_context(self) -> Any:
        from opentelemetry.trace import set_span_in_context

        parent = self._active_span()
        return set_span_in_context(parent) if parent is not None else None

    @staticmethod
    def _event_attributes(payload: dict[str, Any]) -> dict[str, Any]:
        attrs: dict[str, Any] = {}
        for key in ("node", "tool", "route", "error", "input_state_hash",
                    "output_state_hash", "args_hash"):
            value = payload.get(key)
            if value is not None:
                attrs[f"abp.{key}"] = str(value)
        metadata = payload.get("metadata")
        if isinstance(metadata, dict):
            for key, value in metadata.items():
                if isinstance(value, (str, int, float, bool)):
                    attrs[f"abp.meta.{key}"] = value
        return attrs

    # -- _abp_trace observer callbacks ---------------------------------

    def on_run_started(self, run_info: dict[str, Any]) -> None:
        attrs: dict[str, Any] = {
            "abp.run_id": str(run_info.get("run_id")),
            "abp.blueprint": str(run_info.get("blueprint")),
            "abp.blueprint_version": str(run_info.get("blueprint_version")),
            "abp.mode": str(run_info.get("mode")),
        }
        if run_info.get("scenario_id"):
            attrs["abp.scenario_id"] = str(run_info["scenario_id"])
        self._run_span = self._tracer.start_span("abp.run", attributes=attrs)

    def on_event(self, payload: dict[str, Any]) -> None:
        event = payload.get("event")
        if event == "run_finished":
            return  # handled by on_run_finished
        if event == "node_started":
            self._start_node_span(payload)
        elif event == "node_finished":
            self._end_node_span(payload)
        else:
            span = self._active_span()
            if span is None:
                return
            span.add_event(str(event), attributes=self._event_attributes(payload))
            if event in _ERROR_EVENTS:
                from opentelemetry.trace import Status, StatusCode

                span.set_status(Status(StatusCode.ERROR, payload.get("error") or str(event)))

    def on_llm_usage(self, node_id: str, usage: Any, cost_usd: Any) -> None:
        span = self._active_span()
        if span is None:
            return
        if isinstance(usage, dict):
            span.set_attribute("gen_ai.usage.input_tokens", int(usage.get("input_tokens", 0)))
            span.set_attribute("gen_ai.usage.output_tokens", int(usage.get("output_tokens", 0)))
            span.set_attribute("abp.usage.total_tokens", int(usage.get("total_tokens", 0)))
        if cost_usd is not None:
            span.set_attribute("abp.usage.cost_usd", float(cost_usd))

    def on_run_finished(self, status: str, error: str | None) -> None:
        from opentelemetry.trace import Status, StatusCode

        while self._node_spans:
            _, span = self._node_spans.pop()
            span.end()
        if self._run_span is not None:
            if status == "success":
                self._run_span.set_status(Status(StatusCode.OK))
            else:
                self._run_span.set_status(Status(StatusCode.ERROR, error or status))
            self._run_span.end()
            self._run_span = None
        try:
            self._provider.force_flush()
        except Exception:
            pass

    # -- node span lifecycle -------------------------------------------

    def _start_node_span(self, payload: dict[str, Any]) -> None:
        node_id = str(payload.get("node"))
        attrs: dict[str, Any] = {"abp.node.id": node_id}
        model_info = NODE_MODELS.get(node_id)
        if model_info:
            attrs["gen_ai.operation.name"] = "chat"
            attrs["gen_ai.system"] = model_info["system"]
            attrs["gen_ai.request.model"] = model_info["model"]
        if payload.get("input_state_hash"):
            attrs["abp.input_state_hash"] = str(payload["input_state_hash"])
        span = self._tracer.start_span(
            f"abp.node {node_id}", context=self._child_context(), attributes=attrs
        )
        self._node_spans.append((node_id, span))

    def _end_node_span(self, payload: dict[str, Any]) -> None:
        node_id = str(payload.get("node"))
        # pop defensively until the matching span is found
        while self._node_spans:
            open_id, span = self._node_spans.pop()
            if open_id == node_id:
                if payload.get("route"):
                    span.set_attribute("abp.route", str(payload["route"]))
                if payload.get("output_state_hash"):
                    span.set_attribute("abp.output_state_hash", str(payload["output_state_hash"]))
                metadata = payload.get("metadata")
                if isinstance(metadata, dict) and "escalated" in metadata:
                    span.set_attribute("abp.escalated", bool(metadata["escalated"]))
                span.end()
                return
            span.end()


def _disabled_by_env() -> bool:
    return os.environ.get("ABP_OTEL", "on").strip().lower() in ("off", "0", "false", "disabled")


def _build_exporter() -> Any:
    from opentelemetry.sdk.trace.export import ConsoleSpanExporter

    if TRACING_CONFIG["exporter"] == "console":
        return ConsoleSpanExporter()

    # Standard env vars win; only pass the blueprint endpoint when unset.
    env_endpoint = (
        os.environ.get("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT")
        or os.environ.get("OTEL_EXPORTER_OTLP_ENDPOINT")
    )
    endpoint = None if env_endpoint else TRACING_CONFIG["endpoint"]

    if TRACING_CONFIG["protocol"] == "grpc":
        from opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter

        return OTLPSpanExporter(endpoint=endpoint) if endpoint else OTLPSpanExporter()

    from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter

    if endpoint:
        # The http exporter takes the full signal URL when given explicitly
        if not endpoint.rstrip("/").endswith("/v1/traces"):
            endpoint = endpoint.rstrip("/") + "/v1/traces"
        return OTLPSpanExporter(endpoint=endpoint)
    return OTLPSpanExporter()


def init_tracing() -> bool:
    """Set up the OTel provider and register the trace observer.

    Returns True when export is active. Never raises: missing packages or a
    bad configuration disable export with a warning instead of breaking the
    agent.
    """
    global _INITIALIZED
    if _INITIALIZED:
        return True
    if _disabled_by_env():
        return False
    try:
        from opentelemetry import trace
        from opentelemetry.sdk.resources import Resource
        from opentelemetry.sdk.trace import TracerProvider
        from opentelemetry.sdk.trace.export import BatchSpanProcessor
    except ImportError:
        print(
            "⚠  ABP: observability.tracing is enabled but the OpenTelemetry "
            "packages are not installed; trace export is disabled. "
            "Install the generated requirements.txt to enable it.",
            file=sys.stderr,
        )
        return False

    try:
        resource_attrs: dict[str, Any] = {
            "service.version": "{{ ir.version }}",
            "abp.blueprint": "{{ ir.name }}",
        }
        if not os.environ.get("OTEL_SERVICE_NAME"):
            resource_attrs["service.name"] = TRACING_CONFIG["service_name"]

        sampler = None
        ratio = float(TRACING_CONFIG["sample_ratio"])
        if not os.environ.get("OTEL_TRACES_SAMPLER") and ratio < 1.0:
            from opentelemetry.sdk.trace.sampling import ParentBased, TraceIdRatioBased

            sampler = ParentBased(TraceIdRatioBased(ratio))

        if sampler is not None:
            provider = TracerProvider(resource=Resource.create(resource_attrs), sampler=sampler)
        else:
            provider = TracerProvider(resource=Resource.create(resource_attrs))
        provider.add_span_processor(BatchSpanProcessor(_build_exporter()))
        trace.set_tracer_provider(provider)
        tracer = trace.get_tracer("agent-blueprint", "{{ ir.version }}")
        register_trace_observer(OTelTraceObserver(tracer, provider))
    except Exception as exc:
        print(f"⚠  ABP: failed to initialize OpenTelemetry export: {exc}", file=sys.stderr)
        return False

    _INITIALIZED = True
    return True
